PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://deploy:deploy123@localhost:5432/deployment_platform

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# GitHub Webhook
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Docker Registry
REGISTRY_URL=docker.io
REGISTRY_USERNAME=your-dockerhub-username
REGISTRY_PASSWORD=your-dockerhub-access-token

# Multi-Region K3s Configuration (Phase 2)
KUBECONFIG_PATHS=/Users/YOURNAME/.config/k3d/kubeconfig-deploy-platform.yaml,/Users/YOURNAME/.config/k3d/kubeconfig-deploy-platform-ap-south.yaml
REGIONS=us-east-1,ap-south-1
REGION_INGRESS_PORTS=8080,8081

# Legacy single-region fallback
KUBECONFIG_PATH=/Users/YOURNAME/.config/k3d/kubeconfig-deploy-platform.yaml

# Health Check Settings
HEALTH_CHECK_RETRIES=10
HEALTH_CHECK_INTERVAL_MS=5000
HEALTH_CHECK_TIMEOUT_MS=3000
