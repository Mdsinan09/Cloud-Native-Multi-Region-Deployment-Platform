PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://deploy:deploy123@localhost:5432/deployment_platform

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# GitHub Webhook
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Docker Registry
REGISTRY_URL=docker.io
REGISTRY_USERNAME=your-dockerhub-username
REGISTRY_PASSWORD=your-dockerhub-access-token

# K8s
KUBECONFIG_PATH=/Users/YOURNAME/.k3d/kubeconfig-deploy-platform.yaml

# Health Check Settings
HEALTH_CHECK_RETRIES=10
HEALTH_CHECK_INTERVAL_MS=5000
HEALTH_CHECK_TIMEOUT_MS=3000

# For multi-region (Phase 2), comma-separated kubeconfig paths
KUBECONFIG_PATHS=/path/to/us-east-config.yaml,/path/to/ap-south-config.yaml
